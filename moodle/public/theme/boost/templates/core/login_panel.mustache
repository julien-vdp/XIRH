{{!
    @template core/login_panel

    Default content for the left panel of the split-screen login layout.

    Custom authentication instructions, when configured, render inside the
    illustrated welcome panel beneath the Academy introduction.

    Example context (json):
    {
        "leftinstructions": "<p>Welcome to our learning platform. Please log in to continue.</p>"
    }
}}
<div class="login-layout-left-content xa-auth-story">
    <a class="xa-auth-brand" href="{{config.wwwroot}}/index.php?redirect=0" aria-label="XIRH Academy — Accueil">
        {{#pix}} xirh/logo, core {{/pix}}<span>Academy</span>
    </a>
    <div class="xa-auth-copy">
        <p class="xa-auth-eyebrow">UN AUTRE REGARD SUR LES RH</p>
        <h2>Votre prochain déclic<br><em>commence ici.</em></h2>
        <p>Des idées qui bousculent. Des outils qui servent.<br>Un espace pour apprendre, explorer et passer à l’action.</p>
    {{#leftinstructions}}
        <div class="xa-auth-instructions">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
        <a class="xa-auth-back" href="{{config.wwwroot}}/index.php?redirect=0">← Retour à l’accueil</a>
    </div>
    <p class="xa-auth-signature">COMPRENDRE · EXPÉRIMENTER · TRANSFORMER</p>
</div>
