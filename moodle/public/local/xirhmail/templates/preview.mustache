<div class="xm xm-preview"><h2>{{#str}}checkinvitation, local_xirhmail{{/str}}</h2><p><strong>{{name}}</strong> · {{email}}</p><p>{{#str}}subject, local_xirhmail{{/str}} : <strong>{{subject}}</strong></p><p class="xm-note">{{#str}}previewnote, local_xirhmail{{/str}}</p><div class="xm-email">{{{html}}}</div><form method="post" class="xm-confirm"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="nonce" value="{{nonce}}"><input type="hidden" name="userid" value="{{userid}}"><input type="hidden" name="cohortid" value="{{cohortid}}"><button class="btn xm-primary" type="submit">{{#str}}confirmresend, local_xirhmail{{/str}}</button><a class="btn btn-secondary" href="{{backurl}}">{{#str}}cancel{{/str}}</a></form></div>
