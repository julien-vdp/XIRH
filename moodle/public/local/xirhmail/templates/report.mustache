<div class="xm">
  <section class="xm-hero">
    <div><p class="xm-eyebrow">XIRH ACADEMY · {{#str}}staff, local_xirhmail{{/str}}</p><h2>{{#str}}pluginname, local_xirhmail{{/str}}</h2><p>{{#str}}intro, local_xirhmail{{/str}}</p></div>
    <form method="post" action="{{actionurl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="sync"><button class="btn xm-primary" type="submit">{{#str}}syncnow, local_xirhmail{{/str}}</button></form>
  </section>
  <div class="xm-sync"><span>{{#str}}lastsync, local_xirhmail{{/str}} : <strong>{{lastsync}}</strong> · {{#str}}frequency, local_xirhmail{{/str}}</span><a href="{{settingsurl}}">{{#str}}settings, local_xirhmail{{/str}}</a></div>
  {{^enabled}}<div class="alert alert-warning">{{#str}}syncdisabled, local_xirhmail{{/str}} <a href="{{settingsurl}}">{{#str}}settings, local_xirhmail{{/str}}</a></div>{{/enabled}}
  {{#syncerror}}<div class="alert alert-danger" role="alert">{{#str}}syncfailed, local_xirhmail{{/str}}</div>{{/syncerror}}
  {{#oversize}}<div class="alert alert-warning">{{#str}}oversize, local_xirhmail{{/str}}</div>{{/oversize}}
  <form class="xm-filters" method="get">
    <div><label for="xm-cohort">{{#str}}cohort, local_xirhmail{{/str}}</label><select id="xm-cohort" class="form-control" name="cohortid"><option value="0" {{#allcohorts}}selected{{/allcohorts}}>{{#str}}allcohorts, local_xirhmail{{/str}}</option>{{#cohorts}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}}</option>{{/cohorts}}</select></div>
    <div><label for="xm-filter">{{#str}}display, local_xirhmail{{/str}}</label><select id="xm-filter" class="form-control" name="filter"><option value="todo" {{#showtodo}}selected{{/showtodo}}>{{#str}}todo, local_xirhmail{{/str}}</option><option value="all" {{#showall}}selected{{/showall}}>{{#str}}allstudents, local_xirhmail{{/str}}</option></select></div>
    <button class="btn btn-secondary" type="submit">{{#str}}apply, local_xirhmail{{/str}}</button>
  </form>
  <div class="xm-stats"><div><strong>{{total}}</strong><span>{{#str}}students, local_xirhmail{{/str}}</span></div><div class="xm-stat-alert"><strong>{{todo}}</strong><span>{{#str}}todo, local_xirhmail{{/str}}</span></div><div><strong>{{other}}</strong><span>{{#str}}noreportaction, local_xirhmail{{/str}}</span></div></div>
  <p class="xm-note">{{#str}}deliverynote, local_xirhmail{{/str}}</p>
  {{#hasrows}}<div class="xm-table-wrap"><table class="table xm-table"><caption class="sr-only">{{#str}}pluginname, local_xirhmail{{/str}}</caption><thead><tr><th scope="col">{{#str}}student, local_xirhmail{{/str}}</th><th scope="col">{{#str}}status, local_xirhmail{{/str}}</th><th scope="col">{{#str}}lastreturn, local_xirhmail{{/str}}</th><th scope="col">{{#str}}actions, local_xirhmail{{/str}}</th></tr></thead><tbody>
  {{#rows}}<tr><td><strong>{{name}}</strong><span class="xm-line">{{email}}</span>{{#oldemail}}<span class="xm-muted xm-line">{{#str}}previousaddress, local_xirhmail{{/str}} : {{oldemail}}</span>{{/oldemail}}{{#connected}}<span class="xm-muted xm-line">{{#str}}connected, local_xirhmail{{/str}}</span>{{/connected}}</td><td><span class="xm-badge xm-badge-{{state}}">{{statelabel}}</span>{{#sentdate}}<span class="xm-muted xm-line">{{#str}}lastinvite, local_xirhmail{{/str}} : {{sentdate}}</span>{{/sentdate}}</td><td>{{#hasbounce}}<span class="xm-line">{{reason}}</span><span class="xm-muted xm-line">{{bouncedate}} · {{code}}</span><details><summary>{{#str}}details, local_xirhmail{{/str}}</summary><p class="xm-diagnostic">{{diagnostic}}</p></details>{{/hasbounce}}{{^hasbounce}}<span class="xm-muted">{{#str}}nobounce, local_xirhmail{{/str}}</span>{{/hasbounce}}</td><td><div class="xm-actions"><a class="btn btn-sm btn-secondary" href="{{editurl}}">{{#str}}editaddress, local_xirhmail{{/str}}</a>{{#caninvite}}<a class="btn btn-sm xm-primary" href="{{inviteurl}}">{{#str}}resend, local_xirhmail{{/str}}</a>{{/caninvite}}{{^caninvite}}<span class="xm-muted">{{#str}}sendunavailable, local_xirhmail{{/str}}</span>{{/caninvite}}</div></td></tr>{{/rows}}
  </tbody></table></div>{{/hasrows}}
  {{^hasrows}}<div class="xm-empty">{{#str}}empty, local_xirhmail{{/str}}</div>{{/hasrows}}
  <details class="xm-help"><summary>{{#str}}howtoresend, local_xirhmail{{/str}}</summary><ol><li>{{#str}}step1, local_xirhmail{{/str}}</li><li>{{#str}}step2, local_xirhmail{{/str}}</li><li>{{#str}}step3, local_xirhmail{{/str}}</li></ol><p>{{#str}}passwordnote, local_xirhmail{{/str}}</p></details>
  {{#hasunmatched}}<section class="xm-help"><h3>{{#str}}unmatched, local_xirhmail{{/str}}</h3><p>{{#str}}unmatched_desc, local_xirhmail{{/str}}</p><ul>{{#unmatched}}<li>{{email}} · {{code}} · {{date}}</li>{{/unmatched}}</ul></section>{{/hasunmatched}}
</div>
